{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "F1D U02 architecture and lay framing",
  "type": "object",
  "required": [
    "request_id",
    "status",
    "results",
    "artifacts_manifest",
    "limitations",
    "delivery"
  ],
  "additionalProperties": true,
  "properties": {
    "request_id": {
      "const": "f1d-notes-u02-architecture-v1"
    },
    "status": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "BLOCKED"
      ]
    },
    "results": {
      "type": "object",
      "required": [
        "inventory",
        "slide_architecture",
        "transitions",
        "lay_framings",
        "gloss_precedence_rule",
        "answers"
      ],
      "properties": {
        "inventory": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "object",
            "required": [
              "filename",
              "bytes",
              "read_in_full"
            ],
            "properties": {
              "filename": {
                "type": "string"
              },
              "bytes": {
                "type": "integer"
              },
              "read_in_full": {
                "type": "boolean"
              },
              "pages": {
                "type": "integer"
              }
            }
          }
        },
        "slide_architecture": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "items": {
            "type": "object",
            "required": [
              "slide",
              "one_job",
              "must_land",
              "cut_order",
              "word_budget_ack"
            ],
            "properties": {
              "slide": {
                "type": "integer"
              },
              "one_job": {
                "type": "string",
                "description": "One plain sentence."
              },
              "must_land": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cut_order": {
                "type": "array",
                "description": "Ranked must-say first, cut-first last.",
                "items": {
                  "type": "string"
                }
              },
              "word_budget_ack": {
                "type": "integer",
                "description": "The budget for this slide from SPEAKER_NOTES_BUDGET.md."
              },
              "has_more_than_one_job": {
                "type": "boolean"
              }
            }
          }
        },
        "transitions": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": [
              "from_slide",
              "to_slide",
              "what_must_be_set_up",
              "what_must_be_picked_up"
            ],
            "properties": {
              "from_slide": {
                "type": "integer"
              },
              "to_slide": {
                "type": "integer"
              },
              "what_must_be_set_up": {
                "type": "string"
              },
              "what_must_be_picked_up": {
                "type": "string"
              },
              "difficulty": {
                "enum": [
                  "EASY",
                  "MEDIUM",
                  "HARD"
                ]
              }
            }
          }
        },
        "lay_framings": {
          "type": "array",
          "minItems": 15,
          "items": {
            "type": "object",
            "required": [
              "term",
              "shortest_honest_framing",
              "word_count",
              "ceiling_respected",
              "first_used_on_slide"
            ],
            "properties": {
              "term": {
                "type": "string"
              },
              "shortest_honest_framing": {
                "type": "string"
              },
              "word_count": {
                "type": "integer",
                "description": "Count it. The drafter budgets against this."
              },
              "ceiling_respected": {
                "type": "string",
                "description": "Which u01_claim_ledger ceiling this stays inside, or 'none applies'."
              },
              "first_used_on_slide": {
                "type": "integer"
              }
            }
          }
        },
        "gloss_precedence_rule": {
          "type": "object",
          "required": [
            "rule",
            "worked_example"
          ],
          "properties": {
            "rule": {
              "type": "string",
              "description": "Applicable without judgement."
            },
            "worked_example": {
              "type": "string"
            }
          }
        },
        "answers": {
          "type": "object",
          "required": [
            "q1",
            "q2",
            "q3",
            "q4",
            "q5",
            "q6"
          ],
          "additionalProperties": false,
          "patternProperties": {
            "^q[1-6]$": {
              "type": "string",
              "minLength": 60
            }
          }
        }
      }
    },
    "artifacts_manifest": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": [
          "filename",
          "status",
          "media_type",
          "size",
          "sha256"
        ],
        "properties": {
          "filename": {
            "const": "u02_outputs.zip"
          },
          "status": {
            "enum": [
              "CREATED",
              "OMITTED"
            ]
          },
          "media_type": {
            "const": "application/zip"
          },
          "size": {
            "type": "integer"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "contains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "delivery": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "enum": [
          "u02_response.json",
          "u02_outputs.zip"
        ]
      }
    }
  }
}