{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "defense-web-review-response.schema.json",
  "title": "Defense Web Review Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "request_id",
    "verdict",
    "executive_assessment",
    "question_responses",
    "critical_findings",
    "unsupported_or_overstated_wording",
    "revised_proposal",
    "spine_judgment",
    "residual_risks",
    "next_step",
    "provenance",
    "file_contract"
  ],
  "properties": {
    "protocol_version": { "type": "string", "const": "1.0" },
    "request_id": { "type": "string", "minLength": 1 },
    "verdict": { "type": "string", "enum": ["APPROVE", "REVISE", "REJECT"] },
    "executive_assessment": { "type": "string", "minLength": 1 },
    "question_responses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_id", "judgment", "answer", "thesis_evidence", "required_changes"],
        "properties": {
          "question_id": { "type": "string", "pattern": "^Q[0-9]+$" },
          "judgment": {
            "type": "string",
            "enum": ["SUPPORTED", "PARTIALLY_SUPPORTED", "UNSUPPORTED", "NOT_APPLICABLE"]
          },
          "answer": { "type": "string", "minLength": 1 },
          "thesis_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_file", "line_range", "support"],
              "properties": {
                "source_file": { "type": "string", "minLength": 1 },
                "line_range": { "type": "string", "minLength": 1 },
                "support": { "type": "string", "minLength": 1 }
              }
            }
          },
          "required_changes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "critical_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priority", "category", "finding", "why_it_matters", "required_change"],
        "properties": {
          "priority": { "type": "integer", "minimum": 1 },
          "category": { "type": "string", "minLength": 1 },
          "finding": { "type": "string", "minLength": 1 },
          "why_it_matters": { "type": "string", "minLength": 1 },
          "required_change": { "type": "string", "minLength": 1 }
        }
      }
    },
    "unsupported_or_overstated_wording": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["original_wording", "issue", "replacement"],
        "properties": {
          "original_wording": { "type": "string" },
          "issue": { "type": "string", "minLength": 1 },
          "replacement": { "type": "string", "minLength": 1 }
        }
      }
    },
    "revised_proposal": {
      "oneOf": [
        { "type": "object" },
        { "type": "null" }
      ]
    },
    "spine_judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retain", "assessment"],
      "properties": {
        "retain": { "type": "boolean" },
        "assessment": { "type": "string", "minLength": 1 }
      }
    },
    "residual_risks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "next_step": { "type": "string", "minLength": 1 },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["response_origin", "normalized_by_codex"],
      "properties": {
        "response_origin": {
          "type": "string",
          "enum": ["CHATGPT_WEB_DOWNLOAD", "CODEX_NORMALIZED_LEGACY_PROSE"]
        },
        "normalized_by_codex": { "type": "boolean" }
      }
    },
    "file_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["downloadable_file_created", "filename"],
      "properties": {
        "downloadable_file_created": { "type": "boolean", "const": true },
        "filename": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.json$" }
      }
    }
  }
}
