{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "defense-web-review-request.schema.json",
  "title": "Defense Web Review Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "request_id",
    "created_at",
    "task_type",
    "title",
    "source_authority",
    "context",
    "proposal",
    "questions",
    "response_contract",
    "stop_condition"
  ],
  "properties": {
    "protocol_version": { "type": "string", "const": "1.0" },
    "request_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "task_type": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "source_authority": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rank", "file", "role"],
        "properties": {
          "rank": { "type": "integer", "minimum": 1 },
          "file": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "context": { "type": "object" },
    "proposal": { "type": "object" },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "evaluation_criteria", "required_evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^Q[0-9]+$" },
          "question": { "type": "string", "minLength": 1 },
          "evaluation_criteria": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "required_evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "response_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "media_type",
        "schema_file",
        "actual_downloadable_file_required",
        "no_markdown_code_fence",
        "no_prose_outside_json"
      ],
      "properties": {
        "filename": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.json$" },
        "media_type": { "type": "string", "const": "application/json" },
        "schema_file": { "type": "string", "const": "WEB_RESPONSE_SCHEMA.json" },
        "actual_downloadable_file_required": { "type": "boolean", "const": true },
        "no_markdown_code_fence": { "type": "boolean", "const": true },
        "no_prose_outside_json": { "type": "boolean", "const": true }
      }
    },
    "stop_condition": { "type": "string", "minLength": 1 }
  }
}
