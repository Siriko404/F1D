{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["request_id", "status", "results", "artifacts_manifest", "delivery"],
  "properties": {
    "request_id": {"const": "thesis-defense-deck-audit-plan-v2"},
    "status": {"enum": ["COMPLETE", "PARTIAL", "BLOCKED"]},
    "results": {
      "type": "object",
      "required": ["q1", "q2", "q3", "q4", "q5", "q6", "q7", "dimensions", "severity_rubric", "fix_versus_record_rule", "execution_order", "speaker_notes_plan", "plan_self_critique"],
      "properties": {
        "q1": {"type": "string"},
        "q2": {"type": "string"},
        "q3": {"type": "string"},
        "q4": {"type": "string"},
        "q5": {"type": "string"},
        "q6": {"type": "string"},
        "q7": {"type": "string"},
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["dimension_id", "name", "why_it_matters", "cost_of_failure_at_defense", "checks"],
            "properties": {
              "dimension_id": {"type": "string"},
              "name": {"type": "string"},
              "why_it_matters": {"type": "string"},
              "cost_of_failure_at_defense": {"type": "string"},
              "checks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["check_id", "what_to_check", "evidence_source", "method", "pass_criterion", "fail_criterion", "default_severity"],
                  "properties": {
                    "check_id": {"type": "string"},
                    "what_to_check": {"type": "string"},
                    "evidence_source": {"type": "string"},
                    "method": {"enum": ["deterministic", "judgment", "hybrid"]},
                    "method_rationale": {"type": "string"},
                    "pass_criterion": {"type": "string"},
                    "fail_criterion": {"type": "string"},
                    "default_severity": {"enum": ["blocker", "major", "minor", "note"]}
                  }
                }
              }
            }
          }
        },
        "severity_rubric": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["level", "definition", "action"],
            "properties": {
              "level": {"type": "string"},
              "definition": {"type": "string"},
              "action": {"type": "string"}
            }
          }
        },
        "fix_versus_record_rule": {"type": "string"},
        "execution_order": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["step", "dimension_ids", "depends_on", "rationale"],
            "properties": {
              "step": {"type": "integer"},
              "dimension_ids": {"type": "array", "items": {"type": "string"}},
              "depends_on": {"type": "array", "items": {"type": "integer"}},
              "rationale": {"type": "string"}
            }
          }
        },
        "speaker_notes_plan": {
          "type": "object",
          "required": ["structure", "word_budget", "grounding_rules", "quality_gates"],
          "properties": {
            "structure": {"type": "string"},
            "word_budget": {"type": "string"},
            "grounding_rules": {"type": "array", "items": {"type": "string"}},
            "quality_gates": {"type": "array", "items": {"type": "string"}}
          }
        },
        "plan_self_critique": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["blind_spot", "detection_signal"],
            "properties": {
              "blind_spot": {"type": "string"},
              "detection_signal": {"type": "string"}
            }
          }
        },
        "later_call_recommendation": {"type": "string"}
      }
    },
    "artifacts_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["filename", "status", "media_type", "size", "sha256"],
        "properties": {
          "filename": {"type": "string"},
          "status": {"enum": ["CREATED", "MISSING", "NOT_CREATED"]},
          "media_type": {"type": "string"},
          "size": {"type": "integer"},
          "sha256": {"type": "string"}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "delivery": {"type": "array", "items": {"type": "string"}}
  }
}
